license: CC-BY-SA-4.0
repository-code: "https://github.com/macsimplex/coaching-trust-framework"
url: "https://coaching-trust-framework.org"
version: "draft-2026-11-23"
date-released: 2026-11-23
keywords:
  - AI coaching
  - conversational agents
  - AI safety
  - evaluation protocol
  - suicide prevention
  - standards
